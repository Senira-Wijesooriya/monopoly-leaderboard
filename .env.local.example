# Copy this file to .env.local for local development.
# In production these are set in the Vercel dashboard instead (see README).

# Injected automatically once you add the "Upstash Redis" integration
# from the Vercel Marketplace (Storage tab) -- copy the values from
# Vercel > your project > Storage > (the Redis DB) > .env.local tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Your own secret. Generate one with: openssl rand -hex 24
# This becomes the last part of your admin URL: /admin/<ADMIN_SECRET>
ADMIN_SECRET=
